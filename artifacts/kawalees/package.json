    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "4.12.1",
    "eslint": "10.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.6.0",
    "knip": "6.17.1",
    "prettier": "3.8.4",
